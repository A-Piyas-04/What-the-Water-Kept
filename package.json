{
  "name": "what-the-water-kept",
  "version": "1.0.0",
  "description": "What the Water Kept - an offline side-view horror-mystery for mobile",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync:android": "cap sync android"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/node": "^22.10.5",
    "@types/selenium-webdriver": "^4.1.28",
    "selenium-webdriver": "^4.27.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
